# Copy to .env.local for development. NEVER commit real values.
# APP_ENV: development | test | staging | production
APP_ENV=development
APP_URL=http://localhost:3000

# Separate database per environment. Never point staging/dev at production.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/drnk_dev
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5433/drnk_test

# OTP: "dev" is rejected at startup when APP_ENV=production.
# Production requires a real provider (adapter to be wired; see docs/DEPLOYMENT_RUNBOOK.md).
OTP_PROVIDER=dev
OTP_PROVIDER_API_KEY=replace_me

# Session pepper for hashing session tokens (min 32 chars). Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_random_32_plus_chars_value_000000

# Payments: "fake-sandbox" (local deterministic) | "razorpay" (requires test keys)
PAYMENT_PROVIDER=fake-sandbox
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
